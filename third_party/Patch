import os
import runpy

script = os.path.join(builder.currentSourcePath, 'stage_breakpad.py')
builder.AddConfigureFile(script)
stage = runpy.run_path(script)
patches = [
  os.path.join(builder.sourcePath, 'patches', name) for name in [
    '0001-Ignore-invalid-modules-rather-than-bailing-on-the-en.patch',
    '0002-Write-FUNC-records-instead-of-PUBLIC-for-ELF-symbols.patch',
    '0003-Include-the-kernel-s-a.out.h-instead-of-glibc-s.patch',
  ]
]
root, sources = stage['prepare'](
  os.path.join(builder.currentSourcePath, 'breakpad'),
  patches,
  # AMBuild treats files inside buildPath as generated outputs. Configure-time
  # snapshots are prepared sources, not generated command outputs, so keep them
  # outside the object tree. Content addressing makes sharing a generation safe.
  os.path.join(builder.sourcePath, '.build-deps', 'patched'),
)
for path in sources + patches:
  builder.AddConfigureFile(str(path))
Accelerator.breakpad_root = str(root)
# Patching is complete at configure time, before any source paths are registered.
Accelerator.breakpad_patch = []
