import json
import os
import runpy

builder.SetBuildFolder('/')
script = os.path.join(builder.sourcePath, 'build_support.py')
builder.AddConfigureFile(script)
support = runpy.run_path(script)
identity, inputs = support['source_identity'](builder.sourcePath)
for path in inputs:
  builder.AddConfigureFile(str(path))
for path in support['git_config_inputs'](builder.sourcePath) + support['git_config_inputs'](Accelerator.sm_root):
  builder.AddConfigureFile(str(path))
sm_version = support['sourcemod_version'](Accelerator.sm_root)
sm_revision = support['git_revision'](Accelerator.sm_root)
if builder.options.sm_version != 'custom' and sm_version != builder.options.sm_version:
  raise Exception('SourceMod source version does not match --sm-version')
for relative in ['product.version', 'public/IExtensionSys.h']:
  builder.AddConfigureFile(os.path.join(Accelerator.sm_root, relative))
header = support['version_header'](
  open(os.path.join(builder.sourcePath, 'product.version')).read(), identity,
  sm_version, sm_revision)
Accelerator.version_header = builder.AddOutputFile('generated/accelerator_build.h', header.encode())
info = {
  'source': identity,
  'sourcemod': {
    'version': sm_version,
    'revision': sm_revision,
    'custom': builder.options.sm_version == 'custom',
    'dirty': bool(support['git_output'](Accelerator.sm_root, 'status', '--porcelain')) if sm_revision else None,
    'sourcepawn_revision': support['git_revision'](os.path.join(Accelerator.sm_root, 'sourcepawn')),
  },
  'platform': Accelerator.targets[0].target.platform,
  'architectures': sorted(Accelerator.target_archs),
  'optimized': builder.options.opt == '1',
  'symbols': builder.options.debug == '1',
  'compilers': [str(cxx.version) for cxx in Accelerator.targets],
  'dependencies': json.load(open(os.path.join(builder.sourcePath, 'dependencies.json'))),
}
Accelerator.build_info = builder.AddOutputFile(
  'generated/build-info.json', (json.dumps(info, indent=2) + '\n').encode())
